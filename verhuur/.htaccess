
RewriteEngine on
RewriteCond %{HTTP_HOST} ^verhuur\.scoutingveghel\.nl$ [OR]
RewriteCond %{HTTP_HOST} ^www\.verhuur\.scoutingveghel\.nl$
RewriteRule ^/?$ "http\:\/\/scoutingveghel\.nl\#verhuur" [R=301,L]


Options -Indexes
<FilesMatch "\.(html|php)$">
    Header always set Cache-Control "no-store"
</FilesMatch>
<FilesMatch "(?i)(^error_log$|\.(old|bak|sql|tpl)$)">
    Require all denied
</FilesMatch>
